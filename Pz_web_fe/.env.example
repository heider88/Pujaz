# Configuración de Pz_web_fe. Copiar a .env.local para desarrollo.

# Gateway visto desde el servidor de Next.js (páginas que se dibujan en el servidor y reenvío de /graphql).
GATEWAY_URL=http://localhost:4000/graphql

# Solo en desarrollo: el WebSocket del tiempo real va directo al gateway.
# En Docker se deja vacío y el navegador usa ws://<misma dirección>/graphql (lo reenvía Nginx).
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:4000/graphql
