# Clave para firmar y verificar el JWT (obligatoria, mínimo 32 caracteres).
# Generar una con: openssl rand -hex 32
JWT_SECRET=

# Duración del token.
JWT_EXPIRES_IN=24h

# true usa clientes falsos; false usa clientes HTTP hacia los MS.
USE_MOCKS=true

# Obligatorias si USE_MOCKS=false (direcciones de docs/contrato/rest.md §0).
MS_USUARIOS_URL=http://pz-usuarios-cl:8080
MS_SUBASTAS_URL=http://pz-subastas-cl:8081
MS_BILLETERA_URL=http://pz-billetera-cl:8082
MS_CATALOGO_URL=http://pz-catalogo-cl:8000
MS_POSTPUJA_URL=http://pz-postpuja-cl:8000
MS_NOTIFICACIONES_URL=http://pz-notificaciones-cl:8000

PORT=4000
CORS_ORIGIN=http://localhost:5173
