bWidth=90;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=18;fillColor=#E9E9E9;strokeColor=#333333;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="690" y="456" width="666" height="112" as="geometry"/></mxCell><mxCell id="c34" value="«segment»&lt;br&gt;Consultas y mutaciones" style="shape=folder;tabWidth=44;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="702" y="490" width="150" height="64" as="geometry"/></mxCell><mxCell id="c35" value="«segment»&lt;br&gt;Repositorio de autenticación" style="shape=folder;tabWidth=44;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="866" y="490" width="150" height="64" as="geometry"/></mxCell><mxCell id="c36" value="«segment»&lt;br&gt;Cliente GraphQL (HTTP y WebSocket)" style="shape=folder;tabWidth=44;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="150" height="64" as="geometry"/></mxCell><mxCell id="c37" value="«segment»&lt;br&gt;Configuración de URLs" style="shape=folder;tabWidth=44;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1194" y="490" width="150" height="64" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;«tier»: separación física (dónde corre). Caja con nombre: componente (pieza de software).&lt;br&gt;«layer»: separación lógica dentro de un componente; sus nombres dependen del tipo:&lt;br&gt;&amp;nbsp;&amp;nbsp;front-end: Vistas → Estado y sesión → Cliente GraphQL&lt;br&gt;&amp;nbsp;&amp;nbsp;orquestador: Interfaz → Orquestación → Integración&lt;br&gt;&amp;nbsp;&amp;nbsp;microservicio y worker: Interfaz → Lógica de negocio → Acceso a datos e integración&lt;br&gt;«segment»: pieza dentro de una layer, nombrada por lo que hace.&lt;br&gt;Flecha punteada gris fina: «allowed to use» (solo la capa inmediatamente inferior).&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;Flecha punteada roja gruesa&lt;/b&gt;&lt;/font&gt;: «allowed to use below» (cualquier capa inferior).&lt;br&gt;Flechas negras con texto: salidas de cada componente y relaciones entre tiers.&lt;br&gt;Las piezas de una misma layer también se usan entre sí (ver el documento)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3916" y="66" width="760" height="230" as="geometry"/></mxCell><mxCell id="c39" value="«tier» Orquestación" style="shape=folder;tabWidth=200;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=20;fillColor=#F3F3F3;strokeColor=#333333;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="762" width="4716" height="612" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Pz_api_ag&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=6;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="818" width="1068" height="526" as="geometry"/></mxCell><mxCell id="c41" value="«layer» Interfaz" style="shape=folder;tabWidth=90;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=18;fillColor=#E9E9E9;strokeColor=#333333;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="854" width="994" height="112" as="geometry"/></mxCell><mxCell id="c42" value="«segment»&lt;br&gt;Receptor HTTP (c