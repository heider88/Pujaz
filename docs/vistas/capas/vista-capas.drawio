;endFill=0;jumpStyle=none;strokeColor=#555555;strokeWidth=1.5;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="829" y="98" as="sourcePoint"/><mxPoint x="945" y="98" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="f20" value="&lt;b&gt;Gris continua&lt;/b&gt; · &lt;i&gt;allowed-to-use&lt;/i&gt;: entre piezas de un mismo componente, hacia la layer de abajo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="965" y="74" width="585" height="48" as="geometry"/></mxCell><mxCell id="f11" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=open;endFill=0;jumpStyle=none;strokeColor=#000000;strokeWidth=2.5;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="829" y="150" as="sourcePoint"/><mxPoint x="945" y="150" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="f21" value="&lt;b&gt;Negra gruesa&lt;/b&gt; · &lt;i&gt;allowed-to-use&lt;/i&gt;: entre componentes o entre tiers." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="965" y="126" width="585" height="48" as="geometry"/></mxCell><mxCell id="f12" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=open;endFill=0;jumpStyle=none;strokeColor=#C62828;strokeWidth=3.5;dashed=1;dashPattern=4 3;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="829" y="202" as="sourcePoint"/><mxPoint x="945" y="202" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="f22" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;Roja discontinua&lt;/font&gt;&lt;/b&gt; · &lt;i&gt;allowed-to-use-below&lt;/i&gt;: se salta una o más capas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="965" y="178" width="585" height="48" as="geometry"/></mxCell><mxCell id="f23" value="&lt;i&gt;Todas las flechas van de quien usa a quien es usado.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="829" y="230" width="717" height="30" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Layers por tipo de componente&lt;/b&gt; (de arriba hacia abajo)&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:16px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 28px 4px 0;&quot;&gt;&lt;b&gt;Front-end&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 0;&quot;&gt;Vistas → Estado y sesión → Cliente GraphQL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 28px 4px 0;&quot;&gt;&lt;b&gt;WAF&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 0;&quot;&gt;Canal seguro → Filtrado → Reenvío&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 28px 4px 0;&quot;&gt;&lt;b&gt;Proxy inverso&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 0;&quot;&gt;Enrutamiento → Reenvío&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 28px 4px 0;&quot;&gt;&lt;b&gt;Orquestador&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 0;&quot;&gt;Interfaz → Orquestación → Integración&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 28px 4px 0;&quot;&gt;&lt;b&gt;Microservicio y worker&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 0;&quot;&gt;Interfaz → Lógica de negocio → Acceso a datos e integración&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;i&gt;Las piezas de una misma layer también se usan entre sí (ver el documento). Las flechas a las bases bajan por los costados del tier Lógica de negocio; las del broker, por el centro.&lt;/i&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1550" height=