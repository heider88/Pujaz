<mxfile host="app.diagrams.net"><diagram name="Despliegue Pujaz" id="KAN95"><mxGraphModel page="1" pageWidth="1700" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="PUJAZ | Vista de despliegue - Entrega 2 (KAN-95)&#xa;17 servicios Docker Compose | Un host Docker | Puertos predeterminados" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFFFFF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1640" height="75" as="geometry"/></mxCell><mxCell id="public" value="public | bridge | entrada HTTP" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#EAF3FF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="540" height="145" as="geometry"/></mxCell><mxCell id="backend" value="backend | bridge | internal: true" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#EDF7EE;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="30" y="355" width="1060" height="1000" as="geometry"/></mxCell><mxCell id="data" value="data | bridge | internal: true | sin puertos publicados" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFF4DF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1140" y="355" width="530" height="1000" as="geometry"/></mxCell><mxCell id="e0" value="27017" style="edgeStyle=none;endArrow=classic;fontSize=16;strokeColor=#536579;labelBackgroundColor=#ffffff;" edge="1" source="catalogo" target="catalogodb" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="5432" style="edgeStyle=none;endArrow=classic;fontSize=16;strokeColor=#536579;labelBackgroundColor=#ffffff;" edge="1" source="subastas" target="subastasdb" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="5432" style="edgeStyle=none;endArrow=c