| MongoDB 6&#xa;TCP 27017 | red: data&#xa;mongo_data -&gt; /data/db" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFE4AF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1170" y="530" width="470" height="85" as="geometry"/></mxCell><mxCell id="subastas" value="pz-subastas-cl | Go&#xa;HTTP 8081 | redes: backend + data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="430" height="85" as="geometry"/></mxCell><mxCell id="subastasdb" value="pz-subastas-db | PostgreSQL 15&#xa;TCP 5432 | red: data&#xa;subastas_data -&gt; /var/lib/postgresql/data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFE4AF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1170" y="660" width="470" height="85" as="geometry"/></mxCell><mxCell id="billetera" value="pz-billetera-cl | Go&#xa;HTTP 8082 | redes: backend + data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="600" y="790" width="430" height="85" as="geometry"/></mxCell><mxCell id="billeteradb" value="pz-billetera-db | PostgreSQL 15&#xa;TCP 5432 | red: data&#xa;billetera_data -&gt; /var/lib/postgresql/data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFE4AF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1170" y="790" width="470" height="85" as="geometry"/></mxCell><mxCell id="usuarios" value="pz-usuarios-cl | Java / Spring Boot&#xa;HTTP 8080 | redes: backend + data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="600" y="920" width="430" height="85" as="geometry"/></mxCell><mxCell id="usuariosdb" value="pz-usuarios-db | PostgreSQL 15&#xa;TCP 5432 | red: data&#xa;usuarios_data -&gt; /var/lib/postgresql/data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFE4AF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1170" y="920" width="470" height="85" as="geometry"/></mxCell><mxCell id="postpuja" value="pz-postpuja-cl | Python / FastAPI&#xa;HTTP 8000 | redes: backend + data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="600" y="1050" width="430" height="85" as="geometry"/></mxCell><mxCell id="postpujadb" value="pz-postpuja-db | MongoDB 6&#xa;TCP 27017 | red: data&#xa;postpuja_data -&gt; /data/db" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFE4AF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1170" y="1050" width="470" height="85" as="geometry"/></mxCell><mxCell id="notificaciones" value="pz-notificaciones-cl | Python / FastAPI&#xa;HTTP 8000 | redes: backend + data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="600" y="1180" width="430" height="85" as="geometry"/></mxCell><mxCell id="notificacionesdb" value="pz-notificaciones-db | Redis (AOF)&#xa;TCP 6379 | red: data&#xa;notificaciones_data -&gt; /data" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFE4AF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="1170" y="1180" width="470" height="85" as="geometry"/></mxCell><mxCell id="cierre" value="pz-cierre-cl | Worker Go&#xa;Sin puerto de escucha | red: backend&#xa;HTTP cada 60 s a subastas" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="65" y="650" width="440" height="95" as="geometry"/></mxCell><mxCell id="rabbit" value="pz-eventos-mq | RabbitMQ&#xa;Red: backend | AMQP 5672&#xa;Host 5672 -&gt; 5672; 15672 -&gt; 15672&#xa;eventos_data -&gt; /var/lib/rabbitmq" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#D6EDD8;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="65" y="920" width="440" height="115" as="geometry"/></mxCell><mxCell id="legend" value="Lectura del diagrama&#xa;&#xa;Las etiquetas de red son autoritativas:&#xa;frontend SSR pertenece a backend;&#xa;Nginx une public y backend.&#xa;&#xa;Los servicios logicos con BD unen&#xa;backend y data. Las BD solo usan data.&#xa;&#xa;Flechas: rutas seleccionadas de&#xa;comunicacion; no son depends_on." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#FFFFFF;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="65" y="1090" width="440" height="235" as="geometry"/></mxCell><mxCell id="notes" value="DESPLIEGUE Y LIMITES&#xa;Puertos HTTP/TCP internos salvo publicaciones explicitadas. PORT y NGINX_PORT pueden sobrescribir los valores.&#xa;/graphql conserva Authorization y cabeceras Upgrade/Connection; WebSocket extremo a extremo depende del Gateway.&#xa;RabbitMQ: conexiones configuradas desde subastas, billetera, usuarios, postpuja y notificaciones; validar contratos de eventos.&#xa;Persistencia: 7 volumenes nombrados. Arranque: depends_on + service_healthy; cierre usa restart, sin healthcheck HTTP.&#xa;Las redes compartidas no aislan cada servicio entre si. Esta vista describe configuracion, no certifica ejecucion end-to-end." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=18;fillColor=#F3F4F6;strokeColor=#536579;" vertex="1" parent="1"><mxGeometry x="30" y="1380" width="1640" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>